# Settings for `docker compose` (compose.yaml, compose.traefik.yaml).
#
#   cp .env.example .env    # then edit .env; it is git- and docker-ignored
#   docker compose up -d --build
#
# The values below are the defaults: a line left as is changes nothing.
# Meaning of each variable: README, "Konfiguration".

# --- Host port (plain compose.yaml only; behind Traefik no port is published) ---
GEOTANDEM_PORT=8000

# --- First administrator ---
# At least 16 characters, e.g. `openssl rand -base64 24`. Empty: each start
# while no account exists writes a fresh one to the log (docker compose logs).
GEOTANDEM_SETUP_TOKEN=

# --- Background map ---
# none, swisstopo-grau, osm or an own tile URL with {z}/{x}/{y}.
# Anything but none makes browsers fetch tiles from that provider (F-9.1).
GEOTANDEM_BASEMAP=none
# Attribution for an own tile URL.
GEOTANDEM_BASEMAP_ATTRIBUTION=

# --- Sign-in ---
# true once the instance is reached over HTTPS (compose.traefik.yaml sets it).
GEOTANDEM_COOKIE_SECURE=false
GEOTANDEM_SESSION_HOURS=12
GEOTANDEM_SESSION_MAX_DAYS=7
GEOTANDEM_LOGIN_FAILURES=10
GEOTANDEM_LOGIN_FAILURES_PER_ADDRESS=50
GEOTANDEM_LOGIN_FAILURES_PER_USERNAME=20
# Behind a reverse proxy: its address, so sign-in limits count per client.
# compose.traefik.yaml takes TRAEFIK_IPS instead.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Limits ---
GEOTANDEM_MAX_FEATURES=10000
GEOTANDEM_QUERY_TIMEOUT_S=10
GEOTANDEM_MAX_IMPORT_MB=200

# --- Public instance behind Traefik (compose.traefik.yaml; instructions there) ---
#   docker compose -f compose.yaml -f compose.traefik.yaml up -d --build
# Required:
# GEOTANDEM_HOST=geotandem.example.org
# TRAEFIK_IPS=172.18.0.0/16
# Optional, with their defaults:
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_MAX_IMPORT_BYTES=210000000
# GEOTANDEM_SETUP_FROM=127.0.0.1/32
