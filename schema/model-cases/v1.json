    {
      "id": "reference",
      "screens": ["M1.1", "M2.1", "M2.2", "M5.1", "M15.1"],
      "approach": "direct",
      "prompt": "Welche Primarschulen liegen nahe an Kantonsstrassen, in Gemeinden mit hoher Steueranlage?",
      "answer": {
        "kind": "query",
        "explanation": "Ich habe die Frage als Suche nach Primarschulen verstanden, die nahe einer Kantonsstrasse der Kategorie B und in einer Gemeinde mit hoher Steueranlage liegen.",
        "assumptions": [
          {
            "text": "„nahe“ = höchstens 500 m",
            "condition": [1]
          },
          {
            "text": "„Kantonsstrassen“ = Strassenklasse Kantonsstrasse B",
            "condition": [1]
          },
          {
            "text": "„hohe Steueranlage“ = über 1.6",
            "condition": [2]
          }
        ],
        "query": {
          "schema_version": "2",
          "source": "schulen",
          "output": "map",
          "where": {
            "op": "and",
            "args": [
              {
                "op": "in",
                "attr": "typ",
                "values": ["primar"]
              },
              {
                "op": "related",
                "layer": "strassen",
                "predicate": "dwithin",
                "distance_m": 500,
                "where": {
                  "op": "compare",
                  "attr": "klasse",
                  "cmp": "eq",
                  "value": "kantonsstrasse_b"
                }
              },
              {
                "op": "related",
                "layer": "gemeinden_steuern",
                "predicate": "within",
                "where": {
                  "op": "compare",
                  "attr": "steueranlage",
                  "cmp": "gt",
                  "value": 1.6
                }
              }
            ]
          }
        }
      },
      "expect": {
        "status": {
          "Assistenz": "proposed",
          "Prüfen": "proposed",
          "Teilautonom": "approved",
          "Automatisch": "approved"
        },
        "classes": ["query", "spatial"],
        "query_equals": "e2e/fixtures/reference-question.json",
        "hits": 10,
        "total": 137,
        "decision_after_execute": {
          "Teilautonom": "auto",
          "Automatisch": "auto"
        }
      }
    },
