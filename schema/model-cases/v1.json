    {
      "id": "chain_reference",
      "screens": ["M8.1", "M9.1", "M9.3"],
      "approach": "chain",
      "prompt": "Welche Primarschulen liegen nahe an Kantonsstrassen, in Gemeinden mit hoher Steueranlage?",
      "answer": {
        "kind": "plan",
        "explanation": "Ich gehe in fünf Schritten vor: Primarschulen, Puffer um die Kantonsstrassen B, Schulen darin, Gemeinden mit hoher Steueranlage, Schulen darin.",
        "assumptions": [
          {
            "text": "„nahe“ = höchstens 500 m"
          },
          {
            "text": "„hohe Steueranlage“ = über 1.6"
          }
        ],
        "steps": [
          {
            "text": "Primarschulen auswählen",
            "tool": "filter",
            "arguments": {
              "layer": "schulen",
              "where": {
                "op": "in",
                "attr": "typ",
                "values": ["primar"]
              }
            }
          },
          {
            "text": "Puffer 500 m um Kantonsstrassen B",
            "tool": "buffer",
            "arguments": {
              "layer": "strassen",
              "distance_m": 500,
              "where": {
                "op": "compare",
                "attr": "klasse",
                "cmp": "eq",
                "value": "kantonsstrasse_b"
              }
            }
          },
          {
            "text": "Primarschulen im Puffer",
            "tool": "within",
            "arguments": {
              "of": 1,
              "in": 2
            }
          },
          {
            "text": "Gemeinden mit Steueranlage über 1.6",
            "tool": "filter",
            "arguments": {
              "layer": "gemeinden_steuern",
              "where": {
                "op": "compare",
                "attr": "steueranlage",
                "cmp": "gt",
                "value": 1.6
              }
            }
          },
          {
            "text": "Primarschulen in diesen Gemeinden",
            "tool": "within",
            "arguments": {
              "of": 3,
              "in": 4
            }
          }
        ]
      },
