      "gold": {
        "source": "gemeinden",
        "where": {
          "op": "not",
          "arg": {
            "op": "related",
            "layer": "schulen",
            "predicate": "contains",
            "where": {
              "op": "compare",
              "attr": "sekundarstufe",
              "cmp": "eq",
              "value": true
