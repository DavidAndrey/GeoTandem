{
  "_about": "Questions to a real model over the sample dataset (evals/README.md). A case passes when the model's query is accepted and returns the same feature ids as 'gold'; where a question has more than one fair reading, 'require' names what the query must contain instead (source layer, and per condition op, layer, predicate, attribute, value, and a distance range). 'expect' names a non-query answer kind. Questions are worded as users ask them, not as docs/filters.md titles them; the prompt's examples (model/prompt.py) use invented layers, so no case is answered there. 'also' names further answer kinds that pass; 'other_approach' (with 'expect' cannot_answer) is checked when present, null meaning none offered; 'forbid' fails an answer whose text holds one of the words (the prompt's invented example layers). Cases n01-n15: docs/testplan-initial-llm-run.md, 9.",
  "cases": [
    {
      "id": "doc1-primar-koeniz",
      "prompt": "Welche Primarschulen gibt es in Köniz?",
      "gold": {
        "source": "schulen",
        "where": {
          "op": "and",
          "args": [
            {
              "op": "compare",
              "attr": "typ",
              "cmp": "eq",
              "value": "primar"
            },
            {
              "op": "related",
              "layer": "gemeinden",
              "predicate": "within",
              "where": {
                "op": "compare",
                "attr": "name",
                "cmp": "eq",
                "value": "Köniz"
              }
            }
          ]
        }
      }
    },
    {
      "id": "doc2-gut-erschlossen",
      "prompt": "Zeig mir die Haltestellen der Kategorie I oder II und alle Bahnhaltestellen.",
      "gold": {
        "source": "haltestellen",
        "where": {
          "op": "or",
          "args": [
            {
              "op": "in",
              "attr": "kategorie",
              "values": [
                "I",
                "II"
              ]
            },
            {
              "op": "compare",
              "attr": "verkehrsmittel",
              "cmp": "eq",
              "value": "bahn"
            }
          ]
        }
      }
    },
    {
      "id": "doc3-weit-von-bahn",
      "prompt": "Welche Schulen sind mehr als 1 km von der nächsten Bahnhaltestelle entfernt?",
      "gold": {
        "source": "schulen",
        "where": {
          "op": "not",
          "arg": {
            "op": "related",
            "layer": "haltestellen",
            "predicate": "dwithin",
            "distance_m": 1000,
            "where": {
              "op": "compare",
              "attr": "verkehrsmittel",
              "cmp": "eq",
              "value": "bahn"
            }
          }
        }
      }
    },
    {
      "id": "doc4-ohne-sek",
