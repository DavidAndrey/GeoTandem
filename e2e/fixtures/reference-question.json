{
  "schema_version": "2",
  "source": "schulen",
  "output": "map",
  "where": {
    "op": "and",
    "args": [
      { "op": "in", "attr": "typ", "values": ["primar"] },
      {
        "op": "related",
        "layer": "strassen",
        "predicate": "dwithin",
        "distance_m": 500,
        "where": { "op": "compare", "attr": "klasse", "cmp": "eq", "value": "kantonsstrasse_b" }
      },
      {
        "op": "related",
        "layer": "gemeinden_steuern",
        "predicate": "within",
        "where": { "op": "compare", "attr": "steueranlage", "cmp": "gt", "value": 1.6 }
      }
    ]
  }
}
